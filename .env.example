# Copy to .env (shared local defaults) or .env.<environment> (development, test,
# production). Never commit a real .env file. Secrets must never appear here.

# Set the environment in the process environment, not in a .env file.
# AI_YOUTUBE_AGENT_ENVIRONMENT=development

AI_YOUTUBE_AGENT_APP_NAME=ai_youtube_agent
AI_YOUTUBE_AGENT_DEBUG=false
# DEBUG, INFO, WARNING, ERROR or CRITICAL
AI_YOUTUBE_AGENT_LOG_LEVEL=INFO
# SQLite database file; backups go to a backups/ folder next to it
AI_YOUTUBE_AGENT_DATABASE_PATH=data/ai_youtube_agent.db

# Feature flags (safe defaults shown; see src/ai_youtube_agent/core/flags.py)
AI_YOUTUBE_AGENT_FLAGS__SHORTS_ENABLED=true
AI_YOUTUBE_AGENT_FLAGS__LONGFORM_ENABLED=false
AI_YOUTUBE_AGENT_FLAGS__PUBLISH_ENABLED=false
AI_YOUTUBE_AGENT_FLAGS__TEST_REQUIRED=true
AI_YOUTUBE_AGENT_FLAGS__APPROVAL_REQUIRED=true
AI_YOUTUBE_AGENT_FLAGS__AUTO_REPLY_ENABLED=false

# Rights levels that block a publish: a comma separated list (medium,high) or a
# JSON list (["medium", "high"]). The list must include high, and an unknown
# level always blocks. Used by the rights gate of the publish gate.
# AI_YOUTUBE_AGENT_RIGHTS_BLOCK_LEVELS=high

# Version of the policy rule set the publish gate checks with: an integer >= 1.
# An unknown version fails when the publish gate is built, with no fallback.
# AI_YOUTUBE_AGENT_POLICY_RULE_SET_VERSION=1
