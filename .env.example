# Copy to .env (shared local defaults) or .env.<environment> (development, test,
# production). Never commit a real .env file. Secrets must never appear here.

# Set the environment in the process environment, not in a .env file.
# AI_YOUTUBE_AGENT_ENVIRONMENT=development

AI_YOUTUBE_AGENT_APP_NAME=ai_youtube_agent
AI_YOUTUBE_AGENT_DEBUG=false
# DEBUG, INFO, WARNING, ERROR or CRITICAL
AI_YOUTUBE_AGENT_LOG_LEVEL=INFO
# SQLite database file; backups go to a backups/ folder next to it
AI_YOUTUBE_AGENT_DATABASE_PATH=data/ai_youtube_agent.db
# Folder of the generated artifact files (audio, later video and images). One
# folder belongs to one database; it is created on the first write.
# AI_YOUTUBE_AGENT_ARTIFACT_DIR=data/artifacts

# Feature flags (safe defaults shown; see src/ai_youtube_agent/core/flags.py)
AI_YOUTUBE_AGENT_FLAGS__SHORTS_ENABLED=true
AI_YOUTUBE_AGENT_FLAGS__LONGFORM_ENABLED=false
AI_YOUTUBE_AGENT_FLAGS__PUBLISH_ENABLED=false
AI_YOUTUBE_AGENT_FLAGS__TEST_REQUIRED=true
AI_YOUTUBE_AGENT_FLAGS__APPROVAL_REQUIRED=true
AI_YOUTUBE_AGENT_FLAGS__AUTO_REPLY_ENABLED=false

# Voice (text-to-speech) provider. Only the offline mock exists: mock
# AI_YOUTUBE_AGENT_VOICE_PROVIDER=mock

# Video renderer: mock (default, an MP4 container without a track) or ffmpeg
# (needs the ffmpeg program with libx264, aac and drawtext). The binary is a
# program name or path, the timeout is in seconds (1 to 7200) and the optional
# font file is used for captions without a font asset; without it ffmpeg picks
# a system font, so the output is not reproducible across machines.
# AI_YOUTUBE_AGENT_RENDER_PROVIDER=mock
# Local demo with playable MP4 files (APP-01): put this line in your .env.
# AI_YOUTUBE_AGENT_RENDER_PROVIDER=ffmpeg
# AI_YOUTUBE_AGENT_FFMPEG_BINARY=ffmpeg
# AI_YOUTUBE_AGENT_RENDER_TIMEOUT_SECONDS=600
# AI_YOUTUBE_AGENT_RENDER_FONT_FILE=fonts/captions.ttf

# Price of 1,000 characters of TTS script text (0 or more, up to 6 decimals) and
# its currency (3 capital letters). The currency must match the channel budget
# currency, or the audio cost is refused. The default price is 0.
# AI_YOUTUBE_AGENT_TTS_PRICE_PER_1K_CHARACTERS=0
# AI_YOUTUBE_AGENT_TTS_COST_CURRENCY=USD

# Rights levels that block a publish: a comma separated list (medium,high) or a
# JSON list (["medium", "high"]). The list must include high, and an unknown
# level always blocks. Used by the rights gate of the publish gate.
# AI_YOUTUBE_AGENT_RIGHTS_BLOCK_LEVELS=high

# Version of the policy rule set the publish gate checks with: an integer >= 1.
# An unknown version fails when the publish gate is built, with no fallback.
# AI_YOUTUBE_AGENT_POLICY_RULE_SET_VERSION=1

# Hours an approval stays valid before it expires (1 to 720, default 72). An
# expired approval cannot be used to publish until it is revalidated.
# AI_YOUTUBE_AGENT_APPROVAL_TTL_HOURS=72

# Minutes a paid AI API quote stays open for approval, and an approval stays
# usable (1 to 1440, default 30). The paid-API mode itself is saved in the
# database from the web app settings (default: free only).
# AI_YOUTUBE_AGENT_PAID_QUOTE_TTL_MINUTES=30

# YouTube upload retries per publish call (1 to 5, default 3; 1 means no retry)
# and the base of the exponential wait in seconds (0 to 60, default 2).
# AI_YOUTUBE_AGENT_UPLOAD_MAX_ATTEMPTS=3
# AI_YOUTUBE_AGENT_UPLOAD_RETRY_BASE_DELAY_SECONDS=2
